@@   [ 5000 10000 2100 ] [ -14600 2500 7000 ] 3600 398600 LambertU
@@     -> { [ -5.99249 1.92536 3.24564 ] [ -3.31246 -4.19662 -0.38529 ] }  (Curtis Ex.5.2)
